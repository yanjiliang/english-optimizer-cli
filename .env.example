# English Optimizer CLI (cao) Environment Variables
#
# Variables with the `CAO_` prefix can be placed in either `~/.english-optimizer/.env`
# or a local `./.env` without clashing with other projects' `API_KEY` variables.
# (Legacy unprefixed names such as `API_KEY` are still honored from your shell or
# `~/.english-optimizer/.env`.)

# AI Provider Configuration
# Set to 'ollama' for local or 'api' for cloud API
CAO_AI_PROVIDER=ollama

# Ollama Configuration (when CAO_AI_PROVIDER=ollama)
CAO_OLLAMA_BASE_URL=http://localhost:11434
CAO_OLLAMA_MODEL=llama3.2:3b

# API Configuration (when CAO_AI_PROVIDER=api)
# Supported providers: openai, glm, deepseek, qwen, moonshot, openrouter, gemini, custom
CAO_API_PROVIDER=openai
CAO_API_KEY=your_api_key_here
CAO_API_BASE_URL=https://api.openai.com/v1
CAO_API_MODEL=gpt-4o-mini

# For GLM (Zhipu AI)
# CAO_API_PROVIDER=glm
# CAO_API_KEY=your_glm_api_key
# CAO_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CAO_API_MODEL=glm-4

# Features
CAO_ENABLE_HISTORY=true
CAO_ENABLE_CUSTOM_PROMPTS=true
CAO_USE_YAML_PROMPT=true
